{
  "expo": {
    "name": "STARS",
    "slug": "stars-mut",
    "scheme": "stars",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8E8E8"
      }
    },
    "web": {
      "bundler": "metro",
      "lang": "en-ZA",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "STARS needs camera access to scan attendance QR codes."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}

