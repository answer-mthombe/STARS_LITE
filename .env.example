# Public site URL (no trailing slash). Used in app/+html.tsx for og:url and canonical when set.
# EXPO_PUBLIC_SITE_URL=https://stars.example.ac.za

# Supabase (public anon key only — safe in client; still keep .env out of git)
# Create a project at https://supabase.com (JOB-001). Paste values into your local .env only.
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Data source: keep "mock" for the foundation sprint (M0). Switch to "supabase" in M1+ (JOB-027).
EXPO_PUBLIC_DATA_SOURCE=mock
