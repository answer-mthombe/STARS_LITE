# Public site URL (no trailing slash). Used in app/+html.tsx for og:url and canonical when set.
# EXPO_PUBLIC_SITE_URL=https://stars.example.ac.za

# Firebase (public keys only — safe in client; still keep .env out of git)
# Create a web app in Firebase Console and paste values here for M0/M1.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional later: toggle mock vs live data (implement in M5 — see FIREBASE_INTEGRATION.md)
# EXPO_PUBLIC_DATA_SOURCE=mock
