# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native (generated by `expo prebuild` — keep out of repo unless you commit them on purpose)
ios/
android/

# Metro
.metro-health-check*

# Logs & debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# Environment & secrets (keep `.env.example` tracked)
.env
.env.*
!.env.example
# Bare `env` file at repo root (holds local Supabase creds / DB_PASSWORD — never commit)
/env

# TypeScript
*.tsbuildinfo

# Testing / coverage
coverage/

# macOS
.DS_Store
*.pem

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE / editors (optional — remove a line if your team commits these)
.idea/
*.swp
*.swo

# EAS / credentials
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# @generated / caches (Expo / tooling)
expo-env.d.ts
